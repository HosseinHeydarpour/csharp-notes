<Window x:Class="CurrencyConverter_static.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CurrencyConverter_static"
        mc:Ignorable="d"
        Title="مبدل ارز ارزینو" SizeToContent="WidthAndHeight" MinHeight="400" MinWidth="1000" WindowStartupLocation="CenterScreen">
    <!-- 
SizeToContent:
    Determines whether the window size is automatically adjusted based on its content.
    Options:
        Manual          → The window size is set manually (default).
        Width           → The window width adjusts automatically to the content.
        Height          → The window height adjusts automatically to the content.
        WidthAndHeight  → Both width and height adjust automatically to the content.

WindowStartupLocation:
    Determines where the window appears when it first opens.
    Options:
        Manual          → Position is determined by the Top and Left properties.
        CenterScreen    → The window opens centered on the screen.
        CenterOwner     → The window opens centered relative to its owner window.
-->

    <TabControl Name="tbMain" TabStripPlacement="Top" >

        <TabItem Header="مبدل ارز" Name="tbConvertor" FontFamily="IRHoma" FontSize="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="14*"/>
                    <ColumnDefinition Width="129*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions >
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="150"/>
                    <RowDefinition Height="100"/>
                    <RowDefinition Height="150"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="2" Width="800" CornerRadius="10" BorderThickness="5" Grid.Column="1" Margin="2,0,100,0" >
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#ec2075" Offset="0.0"/>
                            <GradientStop Color="#f33944" Offset="0.50"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#ec2075" Offset="0.0"/>
                                <GradientStop Color="#f33944" Offset="0.50"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </Border>

                <!-- By defalu if we do not specify which row we want it takes the first one available -->
                <!-- 
            Orientation="Horizontal":
                  Defines how the child elements inside the StackPanel are arranged.
                  When set to "Horizontal", all elements are placed next to each other from left to right.
    
                  The two possible values are:
                     Horizontal → Items are stacked in a row (left to right).
                     Vertical   → Items are stacked in a column (top to bottom).

                    In this example, the two Label elements will appear side-by-side horizontally.
         -->
                <StackPanel Width="1000" Height="50" Grid.Row="0" Orientation="Horizontal" Grid.ColumnSpan="2" Margin="0,5,0,5" >
                    <Label Content="ابزار مبدل ارزش ارز ارزینو"  Width="1000" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="25" Foreground="#ec2075" FontFamily="IRHoma"></Label>

                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Vertical" HorizontalAlignment="Left" Height="80" Width="1000" Grid.ColumnSpan="2">
                    <Label Height="40" Width="1000" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Content="خروجی" FontSize="20" FontFamily="IRHoma"></Label>
                    <Label Name="lblCurrency" Height="40" Width="1000" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="20"></Label>
                </StackPanel>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Height="60" Width="800" Grid.Column="1" Margin="2,0,0,0">
                    <Label Height="40" Width="100" Content="به" Margin="130 0 0 0" VerticalAlignment="Bottom" Foreground="White" FontSize="20" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" FontFamily="IRHoma"></Label>
                    <Label Height="40" Width="130" Content="از" Margin="110 0 0 0" VerticalAlignment="Bottom" Foreground="White" FontSize="20" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" FontFamily="IRHoma"></Label>
                    <Label Height="40" Width="210" Content="مقدار" Margin="35 0 0 0" VerticalAlignment="Bottom" Foreground="White" FontSize="20" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" FontFamily="IRHoma"></Label>
                </StackPanel>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Height="90" Width="800" VerticalAlignment="Bottom" Grid.Column="1" Margin="2,0,0,0">

                    <ComboBox Name="cmbToCurrency" Width="170" Height="30" Margin="60 0 40 0" FontSize="14" VerticalContentAlignment="Center" 
                      VerticalAlignment="Top" MaxDropDownHeight="150" FontFamily="IRHoma"></ComboBox>

                    <ComboBox Name="cmbFromCurrency" Width="170" Height="30" Margin="40 0 0 0" FontSize="14" VerticalContentAlignment="Center" 
                      VerticalAlignment="Top" MaxDropDownHeight="150" FontFamily="IRHoma"></ComboBox>

                    <TextBox Name="txtCurrency" PreviewTextInput="NumberValidationTextBox" Width="200" Height="30" Margin="40 0 0 0" FontSize="18" 
          VerticalContentAlignment="Center" VerticalAlignment="Top" TextChanged="txtCurrency_TextChanged"/>
                </StackPanel>
                <StackPanel Grid.Row="3" Height="100" Width="1000" Orientation="Horizontal" Grid.ColumnSpan="2">
                    <!--   <Button Name="Convert" Height="40" Width="150" Content="تبدیل" Click="MyClickEvent" Margin="350 0 20 0" Foreground="White" FontSize="20" 
                    Style="{StaticResource ButtonRound}" FontFamily="IRHoma">
            
        -->
                    <Button Name="Convert" Height="40" Width="150" Content="تبدیل" Click="Convert_Click" Margin="350 0 20 0" Foreground="White" FontSize="20" 
        Style="{StaticResource ButtonRound}" FontFamily="IRHoma">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FFD6A073" Offset="0.0"/>
                                <GradientStop Color="#FFEA6464" Offset="0.5"/>
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                    <Button Name="Clear" Height="40" Width="150" Content="پاک کردن" Click="Clear_Click" Foreground="White" FontSize="20" 
                    Style="{StaticResource ButtonRound}" FontFamily="IRHoma">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FFD6A073" Offset="0.0"/>
                                <GradientStop Color="#FFEA6464" Offset="0.5"/>
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Row="4" Height="100" Width="800" HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal" Grid.Column="1" Margin="2,0,0,0">
                    <Image Height="100" Width="800" Source="Images\logo.png" />
                </StackPanel>

            </Grid>

        </TabItem>




        <TabItem Header="نرخ های ارزی" Name="tbRates" FontFamily="IRHoma" FontSize="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"></RowDefinition>
                    <RowDefinition Height="100"></RowDefinition>
                    <RowDefinition Height="60"></RowDefinition>
                    <RowDefinition Height="200"></RowDefinition>
                    <RowDefinition Height="150"></RowDefinition>
                </Grid.RowDefinitions>
                <Border Grid.Row="1" Width="800" CornerRadius="10" BorderThickness="5" Margin="100,0">
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FFD6A073" Offset="0.0"/>
                            <GradientStop Color="#FFEA6464" Offset="0.5"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Rectangle Grid.Row="1">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FFD6A073" Offset="0.0"/>
                                <GradientStop Color="#FFEA6464" Offset="0.5"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </Border>

                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Height="50" Width="1000" VerticalAlignment="Center" Margin="0,5">
                    <Label Height="50" Width="1000" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Content="نرخ ارز" FontSize="25" Foreground="#FFEA6464" FontWeight="Bold"></Label>
                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Height="40" Width="800" Margin="100,0">
                    <Label Height="40" Width="180" Content="مقدار را وارد کنید : " Margin="180 0 0 0" VerticalAlignment="Bottom" Foreground="White" FontSize="20" FlowDirection="RightToLeft"></Label>
                    <Label Height="40" Width="180" Content="نام ارز : " Margin="60 0 0 0" VerticalAlignment="Bottom" Foreground="White" FontSize="20" FlowDirection="RightToLeft"></Label>
                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Height="60" Width="800" VerticalAlignment="Bottom" Margin="100,0">
                    <TextBox Name="txtAmount" Width="200" Height="30" Margin="180 0 0 0" PreviewTextInput="NumberValidationTextBox" FontSize="18" VerticalContentAlignment="Center" VerticalAlignment="Top"></TextBox>
                    <TextBox Name="txtCurrencyName" Width="200" Height="30" Margin="40 0 0 0" FontSize="18" VerticalContentAlignment="Center" VerticalAlignment="Top" MaxLength="50" CharacterCasing="Upper" TextChanged="txtCurrencyName_TextChanged"></TextBox>
                </StackPanel>
                <StackPanel Grid.Row="2" Height="60" Width="1000" Orientation="Horizontal">

                    <Button Name="btnCancel" Height="40" Width="150" Content="لغو" Click="btnCancel_Click"  Margin="350 0 20 0" Foreground="White" FontSize="20" Style="{StaticResource ButtonRound}">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FFD6A073" Offset="0.0"/>
                                <GradientStop Color="#FFEA6464" Offset="0.5"/>
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>

                    <Button Name="btnSave" Height="40" Width="150" Content="ذخیره" Click="btnSave_Click"  Foreground="White" FontSize="20" Style="{StaticResource ButtonRound}">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FFD6A073" Offset="0.0"/>
                                <GradientStop Color="#FFEA6464" Offset="0.5"/>
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                </StackPanel>
                <StackPanel Height="200" Width="800" Grid.Row="3" Margin="150,0" VerticalAlignment="Top">
                    <DataGrid  FlowDirection="RightToLeft"  Name="dgvCurrency" AutoGenerateColumns="False" Height="180" Margin="10" Width="480" Background="Transparent" CanUserAddRows="False" SelectedCellsChanged="dgvCurrency_SelectedCellsChanged" SelectionUnit="Cell" VerticalScrollBarVisibility="Auto" SelectionChanged="dgvCurrency_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="Id" Header="Id" Width="100" CanUserResize="False" Visibility="Hidden" Binding="{Binding Path=Id}"/>

                            <DataGridTextColumn x:Name="CurrencyName"    DisplayIndex="0" Header="نام ارز" Width="*" MinWidth="20" CanUserResize="False" CanUserReorder="False" Binding="{Binding Path=CurrencyName}" IsReadOnly="True"/>

                            <DataGridTextColumn x:Name="Amount"    DisplayIndex="1" Header="مقدار" Width="100" CanUserResize="False" CanUserReorder="False" Binding="{Binding Path=Amount}" IsReadOnly="True"/>



                            <DataGridTemplateColumn Header="ویرایش"    Width="70" IsReadOnly="True" DisplayIndex="2">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image Source="/Images/edit_button.png" ToolTip="Edit" Width="20" Height="20"  x:Name="Revise"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="حذف" Width="70" IsReadOnly="True" DisplayIndex="3">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image Source="/Images/delete_button.png" ToolTip="Delete" Width="20" Height="20"  x:Name="Delete"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            

                           

                           
                           
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
                <StackPanel Grid.Row="4" Height="100" Width="800" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                    <Image Height="100" Width="800" Source="Images\logo.png" />
                </StackPanel>

            </Grid>

        </TabItem>



    </TabControl>




</Window>
