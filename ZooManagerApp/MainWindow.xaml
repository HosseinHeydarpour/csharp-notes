<Window x:Class="ZooManagerApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZooManagerApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="500" Width="725">
    <Grid>
        <Label Content="Zoo List" HorizontalAlignment="Left" Margin="32,29,0,0" VerticalAlignment="Top"/>
        <ListBox Name="listZoos" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="32,60,540,282" SelectionChanged="listZoos_SelectionChanged"/>
        <Label Content="Animals in this zoo" HorizontalAlignment="Left" Margin="273,29,0,0" VerticalAlignment="Top"/>
        <ListBox x:Name="zoosAnimals" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="273,60,299,282"/>

    </Grid>
</Window>
