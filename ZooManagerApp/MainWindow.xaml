<Window x:Class="ZooManagerApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZooManagerApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="500" Width="725">
    <Grid>
        <Label Content="Zoo List" HorizontalAlignment="Left" Margin="32,29,0,0" VerticalAlignment="Top"/>
        <ListBox Name="listZoos" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="32,60,516,174" SelectionChanged="listZoos_SelectionChanged"/>
        <Label Content="Animals in this zoo" HorizontalAlignment="Left" Margin="214,27,0,0" VerticalAlignment="Top"/>
        <ListBox x:Name="zoosAnimals" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="214,60,334,174"/>
        <ListBox d:ItemsSource="{d:SampleData ItemCount=5}" Name="listAnimals" Margin="396,60,172,115"/>
        <Button Content="Add Animal to Zoo" HorizontalAlignment="Left" Margin="396,35,0,0" VerticalAlignment="Top" Width="157" />
        <Button Content="Delete Animal" HorizontalAlignment="Left" Margin="396,374,0,0" VerticalAlignment="Top" Width="157"/>
        <Button Content="Delete Zoo" HorizontalAlignment="Left" Margin="32,315,0,0" VerticalAlignment="Top" Width="177" />
        <Button Content="Remove Animal" HorizontalAlignment="Left" Margin="214,315,0,0" VerticalAlignment="Top" Width="177"/>

    </Grid>
</Window>
