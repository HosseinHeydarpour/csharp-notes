<Window x:Class="ZooManagerApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZooManagerApp"
        mc:Ignorable="d"
        Title="Zoo Manager" Height="500" Width="580">
    <Grid>
        <Label Content="Zoo List" HorizontalAlignment="Left" Margin="32,29,0,0" VerticalAlignment="Top"/>
        <ListBox Name="listZoos" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="32,60,371,162" SelectionChanged="listZoos_SelectionChanged"/>
        <Label Content="Animals in this zoo" HorizontalAlignment="Left" Margin="214,27,0,0" VerticalAlignment="Top"/>
        <ListBox x:Name="zoosAnimals" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="214,60,189,162"/>
        <ListBox d:ItemsSource="{d:SampleData ItemCount=5}" Name="listAnimals" Margin="396,60,27,54" SelectionChanged="listAnimals_SelectionChanged"/>
        <Button Click="OnAddAnimalToZoo" Content="Add Animal to Zoo" HorizontalAlignment="Left" Margin="396,35,0,0" VerticalAlignment="Top" Width="157" />
        <Button Content="Delete Animal" HorizontalAlignment="Left" Margin="396,415,0,0" VerticalAlignment="Top" Width="157" Height="34" Click="OnDeleteAnimal"/>
        <Button Content="Delete Zoo" HorizontalAlignment="Left" Margin="32,307,0,0" VerticalAlignment="Top" Width="177" Click="OnDeleteZoo" Height="34" />
        <Button Content="Remove Animal" HorizontalAlignment="Left" Margin="214,307,0,0" VerticalAlignment="Top" Width="177" Height="34" Click="OnRemoveAnimalFromZoo"/>
        <Button Content="Update Zoo" HorizontalAlignment="Left" Margin="32,415,0,0" VerticalAlignment="Top" Width="177"  Height="34" Click="OnUpdateZoo" />
        <Button Content="Update Animal" HorizontalAlignment="Left" Margin="214,415,0,0" VerticalAlignment="Top" Width="177"  Height="34" Click="OnUpdateAnimal" />
        <Button Content="Add Zoo" HorizontalAlignment="Left" Margin="32,376,0,0" VerticalAlignment="Top" Width="177"  Height="34" Click="OnAddZoo" />
        <Button Content="Add Animal" HorizontalAlignment="Left" Margin="214,376,0,0" VerticalAlignment="Top" Width="177"  Height="34" Click="OnAddAnimal" />
        <TextBox HorizontalAlignment="Left" Margin="32,346,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="359" Height="25" Name="MyTextBox"/>

    </Grid>
</Window>
